{
  "compilerOptions": {
    "target": "ES2020",
    "allowJs": true,
    "module": "commonjs",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "baseUrl": ".",
    "outDir": "dist",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "paths": {
      "@phevere/core": ["packages/core/src/index.ts"],
      "@phevere/core/*": ["packages/core/src/*"]
    }
  },
  "include": ["src/**/*", "packages/core/src/**/*"]
}
