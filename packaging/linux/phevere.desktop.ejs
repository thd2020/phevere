[Desktop Entry]
Name=<%= productName %>
Comment=<%= description %>
GenericName=<%= genericName %>
Exec=/usr/lib/<%= name %>/<%= name %> %U
Icon=<%= name %>
Type=Application
StartupNotify=true
StartupWMClass=phevere
Categories=<%= categories.join(';') %>;
Keywords=dictionary;lookup;translate;vocabulary;OCR;pronunciation;
Actions=lookup-selection;
# KWin grants silent screenshots (OCR) only to an entry whose Exec is the real binary path.
X-KDE-DBUS-Restricted-Interfaces=org.kde.KWin.ScreenShot2

[Desktop Action lookup-selection]
Name=Look Up Selection
Exec=/usr/lib/<%= name %>/<%= name %> --lookup-selection
