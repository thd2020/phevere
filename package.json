{
  "name": "phevere",
  "version": "1.2.2",
  "description": "Cross-platform dictionary application with text selection monitoring",
  "main": ".webpack/main",
  "scripts": {
    "start": "chcp 65001 >nul && electron-forge start",
    "start-admin": "sudo electron-forge start",
    "package": "electron-forge package",
    "make": "npm run prepare:installer && electron-forge make",
    "make:win": "node scripts/make-win.js",
    "make:nsis": "npm run make:win",
    "prepare:installer": "node scripts/prepare-installer-assets.js",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "install": "npm run build-native",
    "build": "npm run build-native",
    "build-native": "cd native-addon && npm install && npm run build",
    "dev": "electron-forge start",
    "test": "node test-integration.js",
    "test-new-popup": "electron-forge start -- --test-new-popup",
    "sync-ocr-models": "node scripts/sync-ocr-models.js"
  },
  "keywords": [
    "dictionary",
    "text-selection",
    "cross-platform",
    "electron",
    "native-addon"
  ],
  "author": {
    "name": "thd2020",
    "url": "https://github.com/thd2020"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/thd2020/phevere.git"
  },
  "bugs": {
    "url": "https://github.com/thd2020/phevere/issues"
  },
  "homepage": "https://github.com/thd2020/phevere#readme",
  "devDependencies": {
    "@electron-addons/electron-forge-maker-nsis": "^7.0.2",
    "@electron-forge/cli": "^7.2.0",
    "@electron-forge/maker-deb": "^7.2.0",
    "@electron-forge/maker-rpm": "^7.2.0",
    "@electron-forge/maker-wix": "^7.11.1",
    "@electron-forge/maker-zip": "^7.2.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.2.0",
    "@electron-forge/plugin-webpack": "^7.2.0",
    "@types/node": "^20.0.0",
    "@types/node-fetch": "^2.6.13",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vercel/webpack-asset-relocator-loader": "^1.10.0",
    "css-loader": "^7.1.2",
    "electron": "^28.0.0",
    "electron-builder": "^26.15.3",
    "electron-wix-msi": "^5.1.3",
    "eslint": "^8.0.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "node-loader": "^2.1.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.2",
    "typescript": "^7.0.2",
    "webpack": "^5.101.0",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@gutenye/ocr-node": "^1.4.8",
    "csv-parse": "^5.5.0",
    "google-translate-api-browser": "^5.0.0",
    "koffi": "^2.15.2",
    "lowdb": "^7.0.1",
    "node-fetch": "^2.7.0",
    "onnxruntime-node": "^1.27.0",
    "sql.js": "^1.14.1",
    "wink-lemmatizer": "^3.0.4"
  },
  "allowScripts": {
    "electron@28.3.3": true,
    "electron-winstaller@5.4.0": true,
    "koffi@2.15.2": true,
    "onnxruntime-node@1.27.0": true,
    "sharp@0.33.5": true
  }
}
