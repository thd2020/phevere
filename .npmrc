# Show lifecycle script output (Electron's got-based fetch is otherwise a bare spinner).
foreground-scripts=true
# Sets ELECTRON_SKIP_BINARY_DOWNLOAD for every lifecycle script (electron postinstall
# included) so npm install cannot hang on got/github. Binary comes from
# scripts/ensure-electron.js (curl). POSIX uses the shebang file; Windows PATHEXT
# picks scripts/npm-lifecycle-shell.cmd.
script-shell=scripts/npm-lifecycle-shell
