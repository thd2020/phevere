# Show lifecycle script output (Electron fetch is otherwise a bare spinner).
foreground-scripts=true
# Prefer China CDN for Electron's own postinstall (`got`). Do not set
# script-shell to an extensionless file: Windows CreateProcess only appends
# .exe, so `scripts/npm-lifecycle-shell` ENOENTs even when a .cmd sibling exists.
electron_mirror=https://cdn.npmmirror.com/binaries/electron/
