#!/usr/bin/env node
'use strict';
/**
 * npm script-shell: inject ELECTRON_SKIP_BINARY_DOWNLOAD so electron/install.js
 * does not call `got` (silent hang on github.com / some mirrors).
 */
process.env.ELECTRON_SKIP_BINARY_DOWNLOAD = '1';

const { spawnSync } = require('child_process');
const args = process.argv.slice(2);
let cmd = '';
if (args[0] === '-c') {
  cmd = args.slice(1).join(' ');
} else {
  cmd = args.join(' ');
}

const isWin = process.platform === 'win32';
const result = spawnSync(
  isWin ? (process.env.ComSpec || 'cmd.exe') : '/bin/sh',
  isWin ? ['/d', '/s', '/c', cmd] : ['-c', cmd],
  { stdio: 'inherit', env: process.env, windowsVerbatimArguments: isWin },
);
process.exit(result.status == null ? 1 : result.status);
